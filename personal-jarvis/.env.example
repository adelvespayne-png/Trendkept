# Copy this file to `.env` and fill in what you have.
#   cp .env.example .env
#
# `.env` is git-ignored. Nothing in here should ever be committed.
# Anything you leave blank simply switches that subsystem off.

# --- reasoning (the only genuinely required setting) ------------------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude Opus 5 — the same model behind Claude itself.
# Effort is the depth/cost dial: low | medium | high | xhigh | max.
# high is the sweet spot; drop to medium if you want cheaper, quicker replies.
# Do not add temperature or top_p — this model rejects them.
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high
JARVIS_MAX_TOKENS=8000

# The chain. If one rung is rate-limited, overloaded, or out of credit, the
# next takes the turn. Every rung carries the same tools, so stepping down
# costs cleverness and nothing else.
#
# `omniroute` is not a model — it means "hand this turn to the gateway", so
# the free providers sit in the middle of the chain rather than at the end.
#
# FREE BY DEFAULT. Every question goes to OmniRoute's free providers, so this
# costs nothing on top of your Claude subscription — which does NOT cover the
# API, they are separate purchases. You do not even need an ANTHROPIC_API_KEY
# for this chain; leave it blank and Jarvis still runs.
#
# The trade: free providers are decent, not Opus. When you want the sharp
# answers back, add Claude AFTER the gateway so it only picks up what the
# free ones genuinely can't handle:
#
#   JARVIS_MODELS=omniroute,claude-opus-5
#
# Deliberately NOT the default: that line starts spending the moment the
# gateway hiccups, and a surprise bill is exactly what this avoids.
JARVIS_MODELS=omniroute

# --- the fallback gateway ---------------------------------------------------
# When every Claude model above is rate-limited or out of credit, the turn
# goes here. The default is OmniRoute — a gateway you run on your own machine
# that fans out across hundreds of providers and switches when one runs dry:
#
#     npm install -g omniroute        then leave it running
#     http://localhost:20128          its dashboard
#
# It carries the SAME TOOLS as the main path — your map, reminders, weather,
# the room, and fetch_page for reading a web page. The only thing that cannot
# follow it here is Anthropic's web *search*, which runs on their servers.
#
# VERIFIED against a real OmniRoute (v3.8.49): the URL below is right, it
# accepts this exact request shape, and these three aliases are real — taken
# from its own /v1/models, which lists 38 auto/* routers in all. Try:
#   auto/best-coding  auto/best-free  auto/cheap  auto/claude-opus  auto/fast
FALLBACK_ENABLED=true
FALLBACK_BASE=http://localhost:20128/v1/chat/completions
FALLBACK_MODELS=auto/best-reasoning,auto/smart,auto/best-free
FALLBACK_TOKEN=

# Prefer GitHub Models instead? Point FALLBACK_BASE at it and add a token —
# Jarvis then reads GitHub's catalogue and picks the best model per maker.
#   FALLBACK_BASE=https://models.github.ai/inference/chat/completions
GITHUB_TOKEN=
GITHUB_LADDER=
GITHUB_LADDER_SIZE=6
GITHUB_CATALOG=https://models.github.ai/catalog/models
GITHUB_CACHE=github_models.json

# Live web search and page reading, run on Anthropic's servers. Without it
# Jarvis only knows what it was trained on — no news, no prices, nothing
# that changed recently.
WEB_ENABLED=true

# --- web search -------------------------------------------------------------
# Anthropic's own web search runs on THEIR servers, so it can't follow Jarvis
# onto a backup provider. This one runs here, so it works on every rung.
#   auto -> brave if keyed, else tavily if keyed, else duckduckgo
#   none -> no local search at all
SEARCH_PROVIDER=auto
SEARCH_RESULTS=6

# Works with no key at all (scrapes DuckDuckGo) — but that is best-effort and
# a layout change on their side breaks it. A key is worth the two minutes:
#   Brave  — brave.com/search/api  (free tier, ~2000 queries a month)
#   Tavily — tavily.com            (free tier, built for assistants)
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- body: exertion and recovery --------------------------------------------
# A wearable's numbers compared against YOUR OWN 14-day baseline. Raw numbers
# never enter a prompt — only "9 above your usual", which is the only form
# that means anything.
#   file  a JSON/CSV your device exports  |  oura  Oura v2  |  none  off
HEALTH_BACKEND=none
HEALTH_FILE=health_input.json
OURA_TOKEN=
HEALTH_HISTORY=health.json
HEALTH_INTERVAL=1800
HEALTH_BASELINE_DAYS=14
# A session this far outside your recent range gets flagged. The trigger for
# exertional trouble is the jump, not the absolute effort.
HEALTH_LOAD_SIGMAS=2.5

# Anything about your body goes to THESE models and never to the free
# gateway — a rotating cast of providers is the wrong place for symptoms.
# Blank means Jarvis refuses to answer rather than sending it elsewhere.
HEALTH_MODELS=claude-opus-5
SYMPTOM_LOG=symptoms.jsonl

# What counts as a red flag is between you and your doctor, so it lives here
# rather than in the code. Rules separated by commas; within a rule, `+` means
# AND and `|` means OR — so "urine|pee + dark|brown" catches "my urine is dark
# brown" and "weeing brown", which a plain word list does not.
#
# A match produces FIXED text from local code. No model decides it, reworders
# it, or gets to think it doesn't apply.
REDFLAG_URGENT=urine|pee|peeing|wee|weeing + dark|brown|cola|tea|red|black,not passing|no urine|not been|barely + urine|pee|weeing,chest pain,palpitations,heart racing,can't move|cannot move|can't walk|cannot walk,confused|confusion,swelling|swollen + bad|severe|really|very|huge
REDFLAG_WATCH=muscle|legs|arms|shoulders|back + pain|sore|ache|aching|hurts,weak|weakness,swollen|swelling,stiff,cramp|cramping,nausea|nauseous|sick,vomit|vomiting|threw up,dizzy|lightheaded,dark|brown + urine|pee

# --- wake word --------------------------------------------------------------
WAKE_ENABLED=true
WAKE_MODEL=hey_jarvis
# Raise towards 0.7 if it triggers on the television; lower to 0.4 if it
# takes two goes to hear you.
WAKE_THRESHOLD=0.5

# --- speech in --------------------------------------------------------------
STT_ENABLED=true
# tiny.en | base.en | small.en — bigger is more accurate and slower.
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_SILENCE_SECONDS=1.2
STT_MAX_SECONDS=15

# --- speech out -------------------------------------------------------------
# piper (local, free) or elevenlabs (cloud, needs a key, sounds better)
TTS_BACKEND=piper
PIPER_MODEL=en_GB-alan-medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- vision (off by default) ------------------------------------------------
VISION_ENABLED=false
CAMERA_INDEX=0
YOLO_MODEL=yolov8n.pt
VISION_INTERVAL=2.0
VISION_CONFIDENCE=0.45

# --- home assistant (off by default) ----------------------------------------
HA_ENABLED=false
HA_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens
HA_TOKEN=
HA_POLL_INTERVAL=10

# --- news (on by default) ---------------------------------------------------
# Headlines are polled into Jarvis's world state, so it always knows roughly
# what today is about without searching, and can flag something major.
NEWS_ENABLED=true
# Comma-separated RSS/Atom URLs. Swap these for whatever you actually read.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_INTERVAL=900
NEWS_PER_FEED=10
NEWS_KEEP=12
# How many headlines ride along in every prompt. More = more aware, more cost.
NEWS_IN_CONTEXT=6
# A NEW headline containing one of these wakes Jarvis to decide whether it is
# worth telling you. Keep the list tight — each match costs a model call.
# Empty this to keep the awareness but never be interrupted about it.
NEWS_WATCH=breaking,emergency,evacuat,earthquake,explosion,crash,collapse,resign,war,strike,recall,outage

# --- phone bridge (off by default) ------------------------------------------
# Lets your phone ask the laptop things. See PHONE.md.
# Make a token with:  python -m jarvis.server --new-token
# It will NOT start without one — this endpoint spends your API credit.
SERVER_ENABLED=false
SERVER_TOKEN=
# 0.0.0.0 = reachable from your phone on the same wifi.
# Use 127.0.0.1 on an untrusted network and reach it via Tailscale instead.
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# Whether the laptop also says the answer out loud when the phone asks.
# Off, because you're usually not in the room.
SERVER_SPEAK_ALOUD=false

# --- behaviour --------------------------------------------------------------
# Whether Jarvis may speak without being spoken to.
PROACTIVE_ENABLED=true
# Minimum seconds between unprompted remarks, whatever the triggers think.
PROACTIVE_COOLDOWN=120

# Your project map — a plain JSON file Jarvis can read and write.
MAP_PATH=map.json
STATE_PATH=state.json
LOG_PATH=conversations.jsonl
LOG_LEVEL=INFO
