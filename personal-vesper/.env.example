# Copy this file to `.env` and fill in what you have.
#   cp .env.example .env
#
# `.env` is git-ignored. Nothing in here should ever be committed.
# Anything you leave blank simply switches that subsystem off.

# --- reasoning (the only genuinely required setting) ------------------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude Opus 5 — the same model behind Claude itself.
# Effort is the depth/cost dial: low | medium | high | xhigh | max.
# high is the sweet spot; drop to medium if you want cheaper, quicker replies.
# Do not add temperature or top_p — this model rejects them.
VESPER_MODEL=claude-opus-5
VESPER_EFFORT=high
VESPER_MAX_TOKENS=8000

# The chain. If one rung is rate-limited, overloaded, or out of credit, the
# next takes the turn. Every rung carries the same tools, so stepping down
# costs cleverness and nothing else.
#
# `omniroute` is not a model — it means "hand this turn to the gateway", so
# the free providers sit in the middle of the chain rather than at the end.
#
# The default is `omniroute`, which CANNOT BILL YOU — but note what that
# means. OmniRoute is a router, not a supply of models. Freshly installed it
# has no providers connected, so it returns an empty pool and Vesper says
# nothing. You have to open its dashboard (localhost:20128) and connect
# providers first; several have free tiers, but each is an account you make.
#
# To use Claude instead, set BOTH of these — changing the key alone does
# nothing, because this line still points at the gateway:
#
#   ANTHROPIC_API_KEY=sk-ant-...
#   VESPER_MODELS=claude-opus-5
#
# Or have the gateway try first and Claude pick up what it cannot handle:
#
#   VESPER_MODELS=omniroute,claude-opus-5
#
# Claude Pro does NOT cover the API; they are separate purchases. Set a spend
# cap in the console.
VESPER_MODELS=omniroute

# --- the fallback gateway ---------------------------------------------------
# When every Claude model above is rate-limited or out of credit, the turn
# goes here. The default is OmniRoute — a gateway you run on your own machine
# that fans out across hundreds of providers and switches when one runs dry:
#
#     npm install -g omniroute        then leave it running
#     http://localhost:20128          its dashboard
#
# It carries the SAME TOOLS as the main path — your map, reminders, weather,
# the room, and fetch_page for reading a web page. The only thing that cannot
# follow it here is Anthropic's web *search*, which runs on their servers.
#
# VERIFIED against a real OmniRoute (v3.8.49): the URL below is right, it
# accepts this exact request shape, and these three aliases are real — taken
# from its own /v1/models, which lists 38 auto/* routers in all. Try:
#   auto/best-coding  auto/best-free  auto/cheap  auto/claude-opus  auto/fast
# SIMPLEST WORKING SETUP, and it does not need OmniRoute at all. Google's
# Gemini API speaks the OpenAI dialect, so you can point this straight at it
# and skip the gateway entirely — no Node, no npm, no dashboard, no second
# window left running. A free key from aistudio.google.com, no card:
#
#   VESPER_MODELS=gateway
#   FALLBACK_BASE=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   FALLBACK_TOKEN=<your Google AI Studio key>
#   FALLBACK_MODELS=<leave this to the tune-up>
#
# DON'T TYPE GOOGLE MODEL NAMES IN BY HAND, and don't trust any list of them
# written down anywhere — including in an older copy of this file. They move
# fast, and a retired name is a hard 404: `gemini-2.5-flash` already answers
# "no longer available to new users". A name can even appear in your own
# key's /v1beta/models listing and STILL 404 when used.
#
# So: run `Tune up Vesper.bat` (or `python -m vesper.launch --tuneup`). It
# asks your key what it can actually reach and writes the answer here,
# strongest first. And if a name does go stale later, Vesper reads the
# replacement out of Google's own error message and carries on.
#
# The one rule worth knowing: a ladder of only Flash-tier models is the
# cheapest, shallowest thing a key can reach. It answers, thinly, and feels
# like it isn't really thinking. Flash belongs at the BOTTOM, as the thing
# that still answers when the good one is busy.
#
# `gateway` and `omniroute` mean the same thing to VESPER_MODELS: "hand this
# turn to whatever FALLBACK_BASE points at". Only the name reads differently.
FALLBACK_ENABLED=true
FALLBACK_BASE=http://localhost:20128/v1/chat/completions
FALLBACK_MODELS=auto/best-reasoning,auto/smart,auto/best-free
FALLBACK_TOKEN=

# --- more than one provider -------------------------------------------------
# THIS IS THE SETTING THAT STOPS VESPER GOING QUIET.
#
# A list of model names is not a fallback if they all sit behind ONE key:
# when that free allowance is spent, every one of them fails in the same
# second. A second PROVIDER is a different endpoint, a different key and a
# different allowance, so it fails independently.
#
# Names: google, github. Order matters — first one that answers wins.
#   FALLBACK_CHAIN=google,github
#
# Leave it blank to keep the old single-endpoint behaviour driven by
# FALLBACK_BASE above. `Tune up Vesper.bat` fills this in for you once it
# can see two keys.
FALLBACK_CHAIN=

# Google AI Studio (aistudio.google.com) — free, no card. Vesper asks the
# key which models it can reach rather than trusting a written-down list.
# If blank, FALLBACK_TOKEN above is used instead.
GOOGLE_API_KEY=

# GitHub Models — free with any GitHub account, no card, and a completely
# separate allowance from Google's.
#
#   github.com -> Settings -> Developer settings
#     -> Personal access tokens -> Fine-grained tokens -> Generate new token
#   Give it the "Models" permission, set to Read-only. Nothing else.
#   It needs NO access to any repository.
#
# Vesper reads GitHub's catalogue and picks the best model from each maker
# itself, so there is no model name to type here either.
GITHUB_TOKEN=
GITHUB_LADDER=
GITHUB_LADDER_SIZE=6
GITHUB_CATALOG=https://models.github.ai/catalog/models
GITHUB_CACHE=github_models.json

# Live web search and page reading, run on Anthropic's servers. Without it
# Vesper only knows what it was trained on — no news, no prices, nothing
# that changed recently.
WEB_ENABLED=true

# --- web search -------------------------------------------------------------
# Anthropic's own web search runs on THEIR servers, so it can't follow Vesper
# onto a backup provider. This one runs here, so it works on every rung.
#   auto -> brave if keyed, else tavily if keyed, else duckduckgo
#   none -> no local search at all
SEARCH_PROVIDER=auto
SEARCH_RESULTS=6

# Works with no key at all (scrapes DuckDuckGo) — but that is best-effort and
# a layout change on their side breaks it. A key is worth the two minutes:
#   Brave  — brave.com/search/api  (free tier, ~2000 queries a month)
#   Tavily — tavily.com            (free tier, built for assistants)
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- body: exertion and recovery --------------------------------------------
# A wearable's numbers compared against YOUR OWN 14-day baseline. Raw numbers
# never enter a prompt — only "9 above your usual", which is the only form
# that means anything.
#   file  a JSON/CSV your device exports
#   push  the device POSTs to /health itself (build-your-own)
#   oura  Oura v2   |   none  off
HEALTH_BACKEND=none
HEALTH_FILE=health_input.json
OURA_TOKEN=
HEALTH_HISTORY=health.json
HEALTH_INTERVAL=1800
HEALTH_BASELINE_DAYS=14
# A session this far outside your recent range gets flagged. The trigger for
# exertional trouble is the jump, not the absolute effort.
HEALTH_LOAD_SIGMAS=2.5

# Anything DANGEROUS goes to these models and never to the free gateway. A
# sore leg is not worth routing elsewhere; something that could put you in
# hospital is. That judgement is the red-flag classifier's, not a keyword
# list's — routine body chat stays free.
# Blank means Vesper gives the fixed instruction and nothing more, rather
# than sending it to whichever provider happened to be up.
HEALTH_MODELS=claude-opus-5
SYMPTOM_LOG=symptoms.jsonl

# Four lists, worst match wins. `+` means AND, `|` means OR, commas separate
# rules — so "urine|pee + dark|brown" catches "my urine is dark brown" and
# "weeing brown", which a plain word list does not.
#
# A match produces FIXED text from local code — no model decides it, rewords
# it, or gets to think it doesn't apply. That path needs no key and no
# network.
#
# This is a starting point across the things that put people in hospital
# quickly, not a medical document. Worth going through with your GP so it
# fits you rather than a generic adult.
#
#   emergency -> call 999 now
#   crisis    -> Samaritans 116 123, or 999 if in danger
#   urgent    -> seen today: A&E or 111
#   watch     -> logged, keep an eye
REDFLAG_EMERGENCY=chest + pain|tight|tightness|crushing|pressure,pain + arm|jaw|neck + spread|spreading|radiat,face + droop|drooping|numb,speech + slurred|slurring|can't speak|cannot speak,arm|leg + numb|weak + one side|left side|right side|suddenly,sudden + confusion|vision loss|worst headache|blinding headache,can't breathe|cannot breathe|struggling to breathe|gasping,throat + closing|swelling|tight,lips|tongue|face + swelling|swollen,passed out|fainted|blacked out|collapsed|unconscious,bleeding + heavy|won't stop|will not stop|soaking,seizure|fitting|convulsion,rash + doesn't fade|does not fade|glass test,fever|temperature + confused|confusion|drowsy|slurred
REDFLAG_CRISIS=kill myself|end my life|end it all|don't want to be here|dont want to be here|want to die|suicidal|self harm|hurt myself|no point going on|better off without me
REDFLAG_URGENT=urine|pee|peeing|wee|weeing + dark|brown|cola|tea|red|black,not passing|no urine|not been|barely + urine|pee|weeing,swelling|swollen + bad|severe|really|very|huge,can't move|cannot move|can't walk|cannot walk,palpitations,heart + racing|pounding|skipping|irregular,breathless + lying down|at rest|walking,calf + pain|swollen|hot,fever|temperature + 39|40|shivering|rigors,wound + hot|red|spreading|pus,headache + sudden|worst|vomiting,vision + blurred|double|lost,abdominal|stomach|belly + severe|rigid|worst,vomiting + blood|coffee,stool|poo + black|tarry|blood
REDFLAG_WATCH=muscle|legs|arms|shoulders|back + pain|sore|ache|aching|hurts,weak|weakness,swollen|swelling,stiff,cramp|cramping,nausea|nauseous|sick,vomit|vomiting|threw up,dizzy|lightheaded,headache,tired|exhausted|wiped|drained,dark|brown + urine|pee,poor sleep|couldn't sleep|not sleeping|insomnia|slept badly|sleeping badly|bad sleep|barely slept,low mood|anxious|anxiety|panicky|stressed

# --- alerts to your phone ---------------------------------------------------
# Speaking aloud only reaches you if you are in the room. This pushes to your
# phone as well, so a red flag finds you in the garden or asleep.
#
#   1. Install "ntfy" from the App Store (free, open source)
#   2. Put a long unguessable string below — it is a PASSWORD, not a name.
#      Anyone who knows the topic can read your alerts.
#   3. Subscribe to the same topic in the app
#   4. Test:  python -m vesper.alerts "test"
ALERT_BACKEND=none
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
ALERT_WEBHOOK=

# The least severe thing worth buzzing your phone for.
#   urgent  only what needs seeing today (recommended)
#   watch   everything logged, including a sore leg
ALERT_MIN_LEVEL=urgent

# --- how she addresses you --------------------------------------------------
# Used once in every reply, on every path — spoken, typed, pushed to your
# phone, and in the fixed emergency text. The system prompt asks for it and
# local code guarantees it, so it holds even on a backup provider that never
# saw the prompt, and even when no model is involved at all.
#
# Change it to anything ("ma'am", "boss", your name). Leave it BLANK to switch
# it off and have her just answer.
ADDRESS=sir

# --- wake word --------------------------------------------------------------
# The spoken trigger is a TRAINED MODEL, not a name you can type. openWakeWord
# ships four phrases and "hey vesper" is not one of them:
#
#   hey_jarvis   -> you say "hey Jarvis"   (default: closest to a name)
#   hey_mycroft  -> you say "hey Mycroft"
#   hey_rhasspy  -> you say "hey Rhasspy"
#   alexa        -> you say "Alexa"
#
# To make it answer to its own name, train the phrase once — free, about an
# hour in a browser, no code — then put the file beside this one and set:
#
#   WAKE_MODEL=hey_vesper.onnx
#
# Walkthrough: WAKE_WORD.md.   See what you are set to:
#   python -m vesper.sensors.wake_word --list
#
# A model that will not load STOPS with an explanation. It deliberately does
# not fall back to the built-in phrases — that would leave you saying "hey
# Vesper" at something listening for "hey Jarvis".
WAKE_ENABLED=true
WAKE_MODEL=hey_jarvis
# Leave blank to derive it from the model, so the interface can never tell you
# to say something different from what is loaded. Set it only to reword.
WAKE_PHRASE=
# Raise towards 0.7 if it triggers on the television; lower to 0.4 if it
# takes two goes to hear you.
WAKE_THRESHOLD=0.5

# --- speech in --------------------------------------------------------------
STT_ENABLED=true
# tiny.en | base.en | small.en — bigger is more accurate and slower.
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_SILENCE_SECONDS=1.2
STT_MAX_SECONDS=15

# --- speech out -------------------------------------------------------------
# piper (local, free) or elevenlabs (cloud, needs a key, sounds better)
TTS_BACKEND=piper
PIPER_MODEL=en_GB-alan-medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- vision (off by default) ------------------------------------------------
VISION_ENABLED=false
CAMERA_INDEX=0
YOLO_MODEL=yolov8n.pt
VISION_INTERVAL=2.0
VISION_CONFIDENCE=0.45

# --- home assistant (off by default) ----------------------------------------
HA_ENABLED=false
HA_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens
HA_TOKEN=
HA_POLL_INTERVAL=10

# --- news (on by default) ---------------------------------------------------
# Headlines are polled into Vesper's world state, so it always knows roughly
# what today is about without searching, and can flag something major.
NEWS_ENABLED=true
# Comma-separated RSS/Atom URLs. Swap these for whatever you actually read.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_INTERVAL=900
NEWS_PER_FEED=10
NEWS_KEEP=12
# How many headlines ride along in every prompt. More = more aware, more cost.
NEWS_IN_CONTEXT=6
# A NEW headline containing one of these wakes Vesper to decide whether it is
# worth telling you. Keep the list tight — each match costs a model call.
# Empty this to keep the awareness but never be interrupted about it.
NEWS_WATCH=breaking,emergency,evacuat,earthquake,explosion,crash,collapse,resign,war,strike,recall,outage

# --- phone bridge (off by default) ------------------------------------------
# Lets your phone ask the laptop things. See PHONE.md.
# Make a token with:  python -m vesper.server --new-token
# It will NOT start without one — this endpoint spends your API credit.
SERVER_ENABLED=false
SERVER_TOKEN=
# 0.0.0.0 = reachable from your phone on the same wifi.
# Use 127.0.0.1 on an untrusted network and reach it via Tailscale instead.
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# Whether the laptop also says the answer out loud when the phone asks.
# Off, because you're usually not in the room.
SERVER_SPEAK_ALOUD=false

# --- behaviour --------------------------------------------------------------
# Whether Vesper may speak without being spoken to.
PROACTIVE_ENABLED=true
# Minimum seconds between unprompted remarks, whatever the triggers think.
PROACTIVE_COOLDOWN=120

# Your project map — a plain JSON file Vesper can read and write.
MAP_PATH=map.json
STATE_PATH=state.json
LOG_PATH=conversations.jsonl
LOG_LEVEL=INFO
