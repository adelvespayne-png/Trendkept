# This repo is public on purpose. Everything Vesper writes while running is
# therefore ignored by default — the code is the shared part, what it learns
# about you is not.

# Secrets. `.env.example` is tracked; `.env` never is.
.env

# --- your body -------------------------------------------------------------
# Health data is the most sensitive thing here and the repo is public, so
# these are listed explicitly rather than left to a wildcard.
health.json
health_input.json
symptoms.jsonl

# The Health limb of the starting map. It names a real medical condition,
# and this repo is public, so it ships in the download rather than here.
# Without it a clone simply has no Health branch; see mapstore.current_seed.
vesper/private_seed.json

# --- what you said, did, and are working on --------------------------------
map.json
memory.json
state.json
conversations.jsonl
reminders.jsonl

# --- test leftovers --------------------------------------------------------
selftest_state.json
selftest_log.jsonl
bridgetest_state.json
bridgetest_log.jsonl
.selftest-drive.mjs

# --- machinery -------------------------------------------------------------
__pycache__/
*.pyc
.venv/
# Speech and vision model weights, downloaded on first run.
*.onnx
*.pt
